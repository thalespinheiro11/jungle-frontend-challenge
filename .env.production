# Build de demonstração (Vercel e `npm run build`): a entrega roda inteiramente sobre os
# mocks MSW (REST + Socket.IO), conforme o enunciado. Sem segredos — arquivo versionado.
# Para apontar para uma API real, defina VITE_ENABLE_MOCKS=false e VITE_API_URL no ambiente.
VITE_ENABLE_MOCKS=true
VITE_API_URL=/api
VITE_SOCKET_URL=
